{
  "expo": {
    "name": "ميزان",
    "slug": "expense-tracker-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expensetrackerapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.elarabygroup.expensetracker",
      "infoPlist": {
        "NSFaceIDUsageDescription": "استخدم Face ID لفتح التطبيق وحماية بياناتك المالية."
      }
    },
    "android": {
      "package": "com.elarabygroup.expensetracker",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "استخدم Face ID لفتح التطبيق وحماية بياناتك المالية."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج التطبيق للوصول لمعرض الصور لإرفاق صورة الفاتورة أو الإيصال.",
          "cameraPermission": "يحتاج التطبيق للوصول للكاميرا لالتقاط صورة الفاتورة أو الإيصال."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F2A47"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "38b63b1c-b5bc-4fec-9c86-38e7d90bf356"
      }
    },
    "owner": "azaky02"
  }
}
